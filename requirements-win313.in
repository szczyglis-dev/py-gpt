# PyHuey / PyGPT Windows 11 + Python 3.13 runtime overlay
#
# Use this after the editable no-deps install:
#
#   cd L:\PyHuey
#   .\.venv313\Scripts\Activate.ps1
#   cd L:\PyHuey\source
#   python -m pip install -e . --no-deps
#   python -m pip install -r requirements-win313.in
#
# This file is intentionally additive. It records dependencies proven necessary
# in the native Windows Python 3.13 environment without forcing the entire
# upstream dependency set at once.
#
# Chroma is intentionally not included here. Use the Python 3.12 Chroma sidecar:
#
#   L:\PyHuey\.venv312-chroma

# GUI/theme startup
qt-material>=2.17,<3

